rules_version = '2';

// ============================================================================
// RASCUNHO — revisar e testar antes de fazer deploy!
// Deploy: npx firebase deploy --only firestore:rules --project king-bt-7f559
// Teste antes no console: Firestore > Regras > Playground, ou emulador local.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function groupData(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data;
    }

    function isMember(gid) {
      return signedIn() && request.auth.uid in groupData(gid).members;
    }

    function isGroupAdmin(gid) {
      return signedIn() && request.auth.uid in groupData(gid).admins;
    }

    // Mesmo e-mail tratado como super admin no cliente (SUPER_ADMIN_EMAILS em
    // AuthContext) e na regra de /config abaixo — super admin não precisa
    // estar na lista `admins` de um grupo específico para gerenciá-lo.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.email == 'joffre.ribeiro@gmail.com';
    }

    // Admin do grupo OU super admin — o portão para excluir/corrigir/editar
    // jogo já registrado. Espelha o ADMIN_ONLY de wrappedDispatch no cliente
    // (CompetitionsContext.tsx); aqui é a versão que vale mesmo se alguém
    // escrever direto no Firestore, ignorando o app.
    function canManageComp(gid) {
      return isGroupAdmin(gid) || isSuperAdmin();
    }

    // Grupo público: qualquer usuário logado pode visitar em modo leitura
    function isPublic(gid) {
      return groupData(gid).visibility == 'publico';
    }

    // Visitante de grupo público solicitando/cancelando inscrição numa
    // competição: só pode mexer no campo joinRequests, nada mais.
    function onlyChangesJoinRequests() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joinRequests']);
    }

    // ── Usuários ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Get por uid específico — usado por removeFromGroup (admin lendo o
      // doc de um membro que está saindo) e pelo próprio dono do doc.
      allow get: if signedIn();
      // NUNCA list: getDocs(collection('users')) sem filtro baixava nome e
      // e-mail de TODOS os usuários do app para qualquer conta logada — era
      // a implementação antiga de searchUsers (tela "adicionar membro
      // existente"). Essa busca agora roda na Cloud Function searchUsers
      // (functions/src/index.ts), com Admin SDK, sem passar pelas regras.
      allow list: if false;
      // Escrita: só o próprio usuário...
      allow write: if signedIn() && request.auth.uid == uid;
      // ...exceto limpar o groupId (e opcionalmente groupIds) de outro
      // usuário — fluxo de remoção individual (removeFromGroup) OU de
      // exclusão do grupo inteiro (deleteGroup, que também tira o grupo do
      // histórico de cada ex-membro). Só quem é admin (ou super admin) do
      // grupo de onde a pessoa está saindo — sem isso, qualquer usuário
      // logado conseguia remover qualquer outro do grupo dele, bastava
      // chamar o SDK direto ignorando o app.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId', 'groupIds'])
        && request.resource.data.groupId == null
        && resource.data.groupId != null
        && (isGroupAdmin(resource.data.groupId) || isSuperAdmin());
    }

    // Contador de rate limit da Cloud Function searchUsers
    // (functions/src/index.ts) — só o Admin SDK toca aqui, que ignora estas
    // regras de qualquer forma. Bloqueio explícito por defesa em
    // profundidade: o cliente nunca tem motivo legítimo pra ler ou escrever
    // isto diretamente.
    match /rateLimits/{doc} {
      allow read, write: if false;
    }

    // ── Grupos ───────────────────────────────────────────────────────────
    match /groups/{gid} {
      // Leitura: só membro ou visitante de grupo público — não expõe mais
      // dados de grupo pra quem não tem nada a ver com ele (ver /groupCodes
      // abaixo, que é o que resolve código→id sem vazar o resto do grupo).
      // Usa `resource.data` (e não isPublic/get) para a consulta "grupos públicos"
      // (where visibility == 'publico') passar: o Firestore só aceita uma LISTA se
      // a regra for provável a partir do filtro da consulta.
      // `request.auth.uid in resource.data.members` (e não isMember(gid), que usa get()) é o que deixa passar
      // também a CONSULTA "grupos em que sou membro" (where members array-contains uid) que o app faz ao
      // entrar: o Firestore só aceita uma lista se a regra for provável a partir do filtro da consulta.
      allow read: if signedIn() && (request.auth.uid in resource.data.members || resource.data.visibility == 'publico');

      // Criação: o criador precisa se colocar como admin e membro
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.admins
        && request.auth.uid in request.resource.data.members;

      // Update: só admin do grupo (ou super admin). Quem tem o código NÃO se
      // adiciona mais sozinho em `members` — cria um pedido em
      // /groups/{gid}/joinRequests/{uid} e o admin aprova (que é quem grava
      // `members`). Antes, a cláusula de auto-adição deixava qualquer pessoa
      // com o código (ou com o id do grupo) entrar sem ninguém autorizar.
      allow update: if isGroupAdmin(gid) || isSuperAdmin();

      allow delete: if isGroupAdmin(gid) || isSuperAdmin();

      // ── Subcoleções: membros leem/escrevem; grupo público permite leitura
      // a qualquer usuário logado (modo visitante, somente leitura) ───────
      // ── Pedidos de entrada ─────────────────────────────────────────────
      // Quem tem o código cria o PRÓPRIO pedido (id = uid) e fica aguardando.
      // Só quem ainda não é membro pede; o conteúdo é só { uid, name, requestedAt }.
      // Lê o pedido: o próprio pedinte (pra saber se foi recusado) e o admin.
      // Apaga: o pedinte (cancelar) ou o admin (aprovar/recusar). Sem update.
      match /joinRequests/{reqUid} {
        allow read: if signedIn() && (reqUid == request.auth.uid || canManageComp(gid));
        allow create: if signedIn()
          && reqUid == request.auth.uid
          && !(request.auth.uid in groupData(gid).members)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.requestedAt is string;
        allow update: if false;
        allow delete: if signedIn() && (reqUid == request.auth.uid || canManageComp(gid));
      }

      match /players/{playerId} {
        allow read: if isMember(gid) || (signedIn() && isPublic(gid));
        // Criar continua liberado a qualquer membro — é o uso legítimo do
        // dia a dia (autocadastro ao entrar no grupo, adicionar um
        // convidado avulso ao montar uma competição).
        allow create: if isMember(gid);
        // Editar. Três caminhos legítimos, e nenhum a mais:
        //  1. Sou o dono do perfil. Vale tanto pelo uid gravado nele quanto
        //     pelo id do doc — um perfil criado pelo próprio usuário nasce
        //     com o uid como id, mas um perfil que o admin cadastrou antes
        //     tem id aleatório e só carrega o uid depois da vinculação.
        //     Checar só o id do doc deixava quem se vinculou sem conseguir
        //     nem trocar o próprio nome (updateProfileName no AuthContext).
        //  2. Admin/super admin: gerencia qualquer perfil do grupo.
        //  3. Vinculação: o perfil ainda não tem dono e estou carimbando o
        //     MEU uid nele, sem tocar em mais nada. É o fluxo de quem entra
        //     no grupo e se reconhece num jogador que o admin já cadastrou
        //     (linkToPlayer). Sem esta cláusula a regra barrava o fluxo
        //     inteiro: o doc tem id aleatório, então nenhuma das outras
        //     passava, e só admin conseguia vincular.
        allow update: if isMember(gid) && (
          resource.data.get('uid', null) == request.auth.uid
          || playerId == request.auth.uid
          || canManageComp(gid)
          || (
            resource.data.get('uid', null) == null
            && request.resource.data.get('uid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'guest'])
          )
        );
        // Apagar: qualquer membro pode remover um CONVIDADO (guest == true —
        // fluxo normal de "desfazer" um convidado adicionado à toa), mas só
        // admin/super admin apaga o perfil de um jogador de verdade.
        allow delete: if isMember(gid) && (resource.data.get('guest', false) == true || canManageComp(gid));

        // Avaliação da comunidade (Radar): cada membro dá UMA nota por
        // habilidade a outro jogador do grupo, no doc ratings/{seuUid}.
        //  - Só membros leem (as notas aparecem no perfil do avaliado).
        //  - Só se grava no doc com o PRÓPRIO uid — ninguém avalia em nome de outro.
        //  - Ninguém avalia a si mesmo: o perfil avaliado não pode ser o do
        //    próprio avaliador (nem pelo id do doc, nem pelo uid vinculado).
        //  - O conteúdo é só { skills, category?, updatedAt }; cada nota é inteiro de 1 a 10
        //    e `category` (opcional) é uma das categorias do app.
        match /ratings/{raterUid} {
          function okScore(sk, k) {
            return !(k in sk) || (sk[k] is int && sk[k] >= 1 && sk[k] <= 10);
          }
          function validSkills(sk) {
            return sk is map
              && sk.keys().hasOnly(['smash', 'lob', 'defesa', 'voleio', 'curtinha', 'saque', 'movimentacao', 'posicionamento', 'mental', 'consistencia'])
              && okScore(sk, 'smash') && okScore(sk, 'lob') && okScore(sk, 'defesa')
              && okScore(sk, 'voleio') && okScore(sk, 'curtinha') && okScore(sk, 'saque')
              && okScore(sk, 'movimentacao') && okScore(sk, 'posicionamento')
              && okScore(sk, 'mental') && okScore(sk, 'consistencia');
          }
          function notSelf() {
            return playerId != request.auth.uid
              && get(/databases/$(database)/documents/groups/$(gid)/players/$(playerId)).data.get('uid', null) != request.auth.uid;
          }

          allow read: if isMember(gid);
          allow create, update: if isMember(gid)
            && raterUid == request.auth.uid
            && notSelf()
            && request.resource.data.keys().hasOnly(['skills', 'category', 'updatedAt'])
            && request.resource.data.keys().hasAll(['skills'])
            && validSkills(request.resource.data.skills)
            // Categoria percebida (opcional): em que categoria quem avalia acha que o jogador joga.
            && (!('category' in request.resource.data)
                || request.resource.data.category in ['Open', 'A', 'B', 'C', 'D', 'Iniciante']);
          allow delete: if isMember(gid) && raterUid == request.auth.uid;
        }
      }

      // ── Desafios ───────────────────────────────────────────────────────
      // Um membro desafia outro para um jogo. Quem desafia cria (sempre "pending", com o
      // próprio uid); só o desafiado aceita/recusa; só o desafiante cancela; um dos dois
      // liga a partida criada ao desafio aceito (uma vez). Admin pode tudo.
      match /challenges/{cid} {
        function chKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(['fromId', 'toId', 'fromUid', 'toUid', 'fromPartnerId', 'toPartnerId', 'message', 'when', 'status', 'createdAt'])
          && request.resource.data.keys().hasAll(['fromId', 'toId', 'fromUid', 'toUid', 'status', 'createdAt'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromUid != request.resource.data.toUid
          && request.resource.data.fromId != request.resource.data.toId
          && request.resource.data.status == 'pending'
          && (!('fromPartnerId' in request.resource.data) || (
            'toPartnerId' in request.resource.data
            && request.resource.data.fromPartnerId is string && request.resource.data.toPartnerId is string
            && request.resource.data.fromPartnerId != request.resource.data.toPartnerId
            && request.resource.data.fromPartnerId != request.resource.data.toId
            && request.resource.data.toPartnerId != request.resource.data.fromId
            && request.resource.data.fromPartnerId != request.resource.data.fromId
            && request.resource.data.toPartnerId != request.resource.data.toId))
          && (!('toPartnerId' in request.resource.data) || 'fromPartnerId' in request.resource.data)
          && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 140))
          && (!('when' in request.resource.data) || (request.resource.data.when is string && request.resource.data.when.size() <= 60));
        allow update: if isMember(gid) && (
          (resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'declined']
            && chKeys().hasOnly(['status', 'respondedAt']))
          || (resource.data.fromUid == request.auth.uid && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && chKeys().hasOnly(['status', 'respondedAt']))
          || ((resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
            && resource.data.status == 'accepted' && !('compId' in resource.data)
            && chKeys().hasOnly(['compId'])
            && request.resource.data.compId is string)
          || canManageComp(gid));
        allow delete: if isMember(gid) && (resource.data.fromUid == request.auth.uid || canManageComp(gid));
      }

      match /competitions/{compId} {
        allow read: if isMember(gid) || (signedIn() && isPublic(gid));

        // Criar uma competição continua liberado a qualquer membro.
        allow create: if isMember(gid);

        // Editar: qualquer membro registra placar e adiciona jogo (Avulso/
        // rodízio) sem precisar de admin — é o uso do dia a dia. Duas coisas
        // exigem canManageComp: encolher `matches` (excluir um jogo — o
        // array só aumenta fora daqui) e trocar `name` (renomear).
        //
        // O que a regra NÃO cobre: trocar os jogadores de um jogo já
        // existente, e corrigir/limpar o placar de um jogo já registrado —
        // ambos ficam do mesmo tamanho de array, então não dá pra distinguir
        // "registrar placar pela primeira vez" de "sobrescrever um resultado"
        // sem comparar cada jogo por índice, o que a linguagem de regras não
        // faz bem para um array de tamanho variável. Hoje esses dois só são
        // barrados no cliente (ADMIN_ONLY em CompetitionsContext.tsx) — quem
        // escrever direto no Firestore, ignorando o app, ainda consegue.
        // Fechar isso de verdade pede validação no servidor (Cloud Function).
        allow update: if isMember(gid) && (
          canManageComp(gid)
          || (
            request.resource.data.matches.size() >= resource.data.matches.size()
            && request.resource.data.name == resource.data.name
          )
        );

        // Visitante de grupo público pode solicitar/cancelar inscrição
        // (Fase 3) sem virar membro — só o campo joinRequests é alterável.
        allow update: if signedIn() && isPublic(gid) && onlyChangesJoinRequests();

        allow delete: if canManageComp(gid);

        // Placar ao vivo / rascunho (Quadra ao Vivo, King Scout) — campos
        // efêmeros, apagados quando o placar final é salvo. Fora do array
        // `matches` de propósito: assim cada ponto marcado grava só este
        // doc pequeno, em vez de reescrever a competição inteira. Mesma
        // abertura de sempre (qualquer membro escreve) — não é
        // endurecimento de segurança, só performance.
        match /liveMatches/{matchId} {
          allow read: if isMember(gid) || (signedIn() && isPublic(gid));
          allow write: if isMember(gid);
        }
      }

      match /feed/{feedId} {
        allow read: if isMember(gid) || (signedIn() && isPublic(gid));
        // Criar o post continua aberto a qualquer membro.
        allow create: if isMember(gid);

        // Editar (reagir, comentar, apagar o próprio comentário) — três
        // formatos de escrita possíveis no mesmo doc, cada um com sua regra:
        //  1. Admin/super admin: modera livremente (qualquer campo).
        //  2. Reação: só o campo `reactions` mudou — livre pra qualquer
        //     membro, sem checar autoria (like é público por natureza).
        //  3. Comentário novo: só `comments` mudou, cresceu em exatamente 1,
        //     e o item adicionado tem o uid de quem está mandando — sem
        //     isso, dava pra postar um comentário assinado com o uid de
        //     outra pessoa.
        //  4. Apagar comentário: só `comments` mudou, encolheu em exatamente
        //     1, e o item que sumiu era meu (ou eu sou admin) — sem isso,
        //     qualquer membro apagava o comentário de qualquer outro.
        allow update: if isMember(gid) && (
          canManageComp(gid)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            && request.resource.data.comments.size() == resource.data.comments.size() + 1
            && request.resource.data.comments[request.resource.data.comments.size() - 1].uid == request.auth.uid
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            && resource.data.comments.size() == request.resource.data.comments.size() + 1
            && resource.data.comments.removeAll(request.resource.data.comments).size() == 1
            && resource.data.comments.removeAll(request.resource.data.comments)[0].uid == request.auth.uid
          )
        );
        // Apagar o post — hoje só acontece junto da exclusão do jogo que o
        // gerou (deleteFeedItemsByMatch, chamado por DELETE_MATCH) — exige
        // o mesmo admin do jogo.
        allow delete: if canManageComp(gid);
      }

      match /analises/{matchId} {
        allow read: if isMember(gid) || (signedIn() && isPublic(gid));
        allow write: if isMember(gid);
      }

      match /treinos/{treinoId} {
        allow read: if isMember(gid) || (signedIn() && isPublic(gid));
        allow write: if isMember(gid);
      }
    }

    // ── Códigos de convite (código → id do grupo) ─────────────────────────
    // Coleção separada, só com { groupId } — nunca os dados do grupo em si.
    // Existe pra resolver "entrar por código" sem precisar ler /groups (que
    // agora exige ser membro/visitante público — ver acima). Sem isso, achar
    // um grupo pelo código dependia de ler a coleção /groups inteira, o que
    // também deixava qualquer autenticado descobrir e entrar num grupo
    // "privado" sem nunca ter recebido o código.
    match /groupCodes/{code} {
      // `get` por código exato, nunca `list`. Com `read` (que é get + list)
      // qualquer conta logada podia baixar a coleção inteira e sair com o
      // groupId de TODOS os grupos do app; somada à regra de `members` acima
      // — que deixa um não-membro se adicionar sozinho — isso dava entrada
      // livre em qualquer grupo privado, sem nunca ter visto o código.
      // O app só lê por getDoc(code), então perder o list não custa nada.
      allow get:  if signedIn();
      allow list: if false;
      // Só cria quem já é admin do grupo referenciado — na prática, só
      // createGroup() logo após criar o próprio grupo.
      //
      // O doc também guarda a PRÉVIA pública do grupo (nome, descrição,
      // visibilidade): é o que a pessoa vê ao abrir o convite, antes de
      // pedir para entrar (um grupo privado não pode ser lido por não-membro).
      allow create: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins
        && request.resource.data.keys().hasOnly(['groupId', 'name', 'description', 'visibility']);
      // O código (e o grupo a que aponta) não muda; o admin só atualiza a prévia.
      allow update: if (isGroupAdmin(resource.data.groupId) || isSuperAdmin())
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'visibility']);
      allow delete: if isGroupAdmin(resource.data.groupId) || isSuperAdmin();
    }

    // ── Config global (fórmula de pontuação etc.) ────────────────────────
    // Leitura por qualquer autenticado; escrita só pelo Super Admin.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.email == 'joffre.ribeiro@gmail.com';
    }

    // Bloqueia qualquer outro caminho
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
