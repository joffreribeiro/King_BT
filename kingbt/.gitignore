# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (.env contém a chave do Sentry; não commitar)
.env
.env*.local

# binários de build (APK/AAB são gerados, não versionados)
*.apk
*.aab

# typescript
*.tsbuildinfo

# Firebase Admin key (nunca commitar)
serviceAccount*.json
**/serviceAccount*.json

# generated native folders
/ios
/android

# log do emulador do Firestore rodando localmente (npm run test:rules)
firestore-debug.log

# Cloud Functions: build compilado (gerado de functions/src por `npm run build`)
functions/lib/

# cache local do Firebase CLI (dry-run, deploy, emulador)
.firebase/
